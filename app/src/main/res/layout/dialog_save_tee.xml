<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Course Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCourseName"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Course Name"
            android:layout_marginBottom="16dp">

            <AutoCompleteTextView
                android:id="@+id/actvCourseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:completionThreshold="1"
                android:imeOptions="actionNext" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Course Option / Layout (Short, Long, Pro, etc.) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCourseOption"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Layout / Option (e.g. Short, Long, Pro)"
            android:layout_marginBottom="16dp">

            <AutoCompleteTextView
                android:id="@+id/actvCourseOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:completionThreshold="1"
                android:imeOptions="actionNext" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Hole Number -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHoleNumber"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Hole Number"
            android:layout_marginBottom="8dp">

            <AutoCompleteTextView
                android:id="@+id/actvHoleNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:focusable="false"
                android:focusableInTouchMode="false" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Hint shown when some holes are already used -->
        <TextView
            android:id="@+id/tvUsedHolesHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

    </LinearLayout>

</ScrollView>
