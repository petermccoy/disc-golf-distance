<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/toolbar_bg"
            app:title="@string/app_name"
            app:titleTextColor="@color/text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- GPS Accuracy Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/ivGpsIndicator"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_gps"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvGpsAccuracy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS: acquiring…"
                    android:textColor="@color/accuracy_poor"
                    android:textSize="14sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

            <!-- Session Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <TextView
                    android:id="@+id/tvSessionInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Session: —\nNo throws yet"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    tools:ignore="HardcodedText" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Aim Direction Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aim Direction"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Live compass bearing (shown when not set) -->
                        <TextView
                            android:id="@+id/tvLiveCompass"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="— °  (acquiring…)"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:fontFamily="monospace" />

                        <!-- Set Aim button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetAim"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Set Aim"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_compass"
                            app:iconSize="16dp"
                            app:iconGravity="textStart" />

                    </LinearLayout>

                    <!-- Aim set row (visible only when aim is locked) -->
                    <LinearLayout
                        android:id="@+id/rowAimSet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvAimSet"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/accuracy_good"
                            android:textSize="13sp"
                            android:fontFamily="monospace" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearAim"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Clear"
                            android:textSize="12sp"
                            android:textColor="@color/accuracy_poor" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Rangefinder Card (visible when a basket is known for the selected hole) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRangefinder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/accent"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Header: hole label -->
                    <TextView
                        android:id="@+id/tvRangefinderLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RANGEFINDER"
                        android:textColor="@color/accent"
                        android:textSize="11sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="6dp" />

                    <!-- Big distance display -->
                    <TextView
                        android:id="@+id/tvRangeDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="— ft"
                        android:textColor="@color/text_primary"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="2dp" />

                    <!-- Metres sub-label -->
                    <TextView
                        android:id="@+id/tvRangeDistanceM"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="— m"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="8dp" />

                    <!-- Bearing + elevation row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvRangeBearing"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="—° —"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tvRangeElevation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:fontFamily="monospace"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!-- Mark Basket button – shown when NO basket exists for this hole -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMarkBasket"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="10dp"
                        android:text="Mark Basket Location Here"
                        android:textSize="12sp"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Fixed Start (Tee) Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFixedStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Header row: label + toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fixed Start (Tee)"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:textAllCaps="true"
                                android:letterSpacing="0.1" />

                            <TextView
                                android:id="@+id/tvFixedStartSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Use GPS location"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchFixedStart"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <!-- Shown when switch is ON -->
                    <LinearLayout
                        android:id="@+id/rowTeeStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvTeeStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Scanning for nearby tees…"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:fontFamily="monospace" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelectTee"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Select"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Start Location Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartLocation"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:text="@string/btn_start"
                android:textSize="18sp"
                android:textColor="@color/text_on_action"
                app:backgroundTint="@color/btn_start"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_pin_start"
                app:iconGravity="textStart"
                android:layout_marginBottom="12dp" />

            <!-- End Location Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEndLocation"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:text="@string/btn_end"
                android:textSize="18sp"
                android:textColor="@color/text_on_action"
                app:backgroundTint="@color/btn_end"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_pin_end"
                app:iconGravity="textStart"
                android:enabled="false"
                android:alpha="0.4"
                android:layout_marginBottom="16dp" />

            <!-- Active throw card (visible when start is marked) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStarted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/card_active_bg"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/btn_start"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:text="Start Location Marked"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/btn_start"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/tvStartTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        tools:text="Started: 14:32:10" />

                    <TextView
                        android:id="@+id/tvStartCoords"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        tools:text="37.123456, -122.654321  ±3m" />

                    <!-- Row: Save as tee + Cancel start -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <!-- Only visible when start is a live GPS point (not already a fixed tee) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveAsTee"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="Save as Tee"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelStart"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Cancel Start"
                            android:textColor="@color/accuracy_poor"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Status message -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_ready"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="8dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
